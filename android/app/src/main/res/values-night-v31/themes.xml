<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+: the splash window takes the desk colour too (the attribute does not exist below 31). -->
    <style name="Theme.Receipts" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/desk</item>
        <item name="android:windowSplashScreenBackground">@color/desk</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
